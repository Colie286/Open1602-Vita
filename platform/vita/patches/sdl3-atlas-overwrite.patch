+    // every sprite uploaded into previously unused space.
+    const SDL_PropertiesID props = SDL_GetTextureProperties(texture);
+    const bool overwrite = SDL_GetBooleanProperty(props, "open1602.texture.overwrite_pending", false);
+    if (vita_texture->tex->gxm_rendertarget || overwrite) {
         sceGxmFinish(data->gxm_context);
+        if (overwrite) {
+            SDL_ClearProperty(props, "open1602.texture.overwrite_pending");
+        }
     }
 
     return true;
